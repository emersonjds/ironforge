{
  "name": "ironforge",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/patch-expo-monkey.mjs",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest --testPathPatterns='tests/unit'"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/tests/unit/**/*.test.ts",
      "**/tests/unit/**/*.test.tsx"
    ],
    "moduleNameMapper": {
      "^@entities/(.*)$": "<rootDir>/src/entities/$1",
      "^@shared/(.*)$": "<rootDir>/src/shared/$1",
      "^@features/(.*)$": "<rootDir>/src/features/$1",
      "^@widgets/(.*)$": "<rootDir>/src/widgets/$1",
      "^@app/(.*)$": "<rootDir>/app/$1",
      "^@ui/(.*)$": "<rootDir>/src/shared/ui/$1",
      "^@lib/(.*)$": "<rootDir>/src/shared/lib/$1",
      "^@theme/(.*)$": "<rootDir>/src/shared/theme/$1",
      "^@types/(.*)$": "<rootDir>/src/types/$1",
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/(?!metro)|@expo-google-fonts|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg|nativewind)"
    ]
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@expo/vector-icons": "^15.0.3",
    "@hookform/resolvers": "^3.9.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@tanstack/react-query": "^5.59.0",
    "babel-preset-expo": "~54.0.10",
    "expo": "~54.0.33",
    "expo-constants": "~18.0.13",
    "expo-file-system": "~19.0.24",
    "expo-font": "~14.0.11",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-image-picker": "~17.0.11",
    "expo-linking": "~8.0.11",
    "expo-router": "~6.0.23",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "expo-updates": "~29.0.20",
    "expo-video": "~3.0.16",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.54.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "0.5.1",
    "zod": "^3.23.8",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/jest": "29",
    "@types/react": "~19.1.0",
    "@typescript-eslint/eslint-plugin": "8",
    "@typescript-eslint/parser": "8",
    "babel-plugin-module-resolver": "^5.0.3",
    "eslint": "9",
    "eslint-plugin-boundaries": "^6.0.2",
    "jest": "29",
    "jest-expo": "~54.0.18",
    "nativewind": "^4.2.3",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.8",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.9.2"
  },
  "packageManager": "pnpm@10.0.0"
}
