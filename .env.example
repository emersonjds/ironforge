# URL base da API (ironforge-api).
#
# Opcional em desenvolvimento: o app detecta sozinho o host que serve o bundle
# do Expo (simulador iOS, emulador Android ou celular físico na mesma rede) e
# usa a porta 3333. Defina esta variável só se precisar apontar para outro
# endereço (ex.: um ambiente remoto).
#
# Obrigatória em build de produção — não existe host de bundler para detectar.
EXPO_PUBLIC_API_URL=http://localhost:3333

# Endereço do painel web (ironforge-web), usado na tela de orientação exibida
# ao personal. Opcional: sem a variável, o app usa https://ironforge.app.
EXPO_PUBLIC_WEB_PANEL_URL=https://ironforge.app
